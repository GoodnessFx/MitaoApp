# =============================================================================
# MITAO — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values when ready.
# Everything runs on mock data until real credentials are provided.
# =============================================================================

# --- Supabase (Database + Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- CJDropshipping (Sourcing/Procurement) ---
CJDROPSHIPPING_API_KEY=your-cj-access-token
CJDROPSHIPPING_BASE_URL=https://developers.cjdropshipping.com/api2.0
# Set to "sandbox" while testing, "production" when live
CJDROPSHIPPING_MODE=sandbox

# --- Payments ---
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-flutterwave-public-key

# --- Email (Resend) ---
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@mitao.com

# --- Media / CDN ---
# Supabase Storage is used for product images (included in Supabase plan)
# Cloudflare free CDN sits in front for fast delivery
SUPABASE_STORAGE_BUCKET=product-images
CLOUDFLARE_CDN_URL=https://your-cdn.cloudflare.com

# --- Push Notifications (Firebase Cloud Messaging) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# --- Error Tracking (Sentry) ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# --- App Config ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars

# --- Feature Flags ---
# Set to "mock" to use fake data, "live" to use real API integrations
SOURCING_MODE=mock
AUTH_MODE=mock
PAYMENT_MODE=mock
